const API="http://localhost:5001/api";
const fmt=n=>n>=1e6?(n/1e6).toFixed(1)+"M":n>=1000?(n/1000).toFixed(1)+"K":String(n);
const money=n=>"$"+Math.round(n/1000)+"K";
const CL=["#0ea5e9","#8b5cf6","#10b981","#f59e0b","#ef4444","#ec4899","#06b6d4","#84cc16","#f97316","#6366f1","#14b8a6","#e11d48","#a855f7","#22c55e","#eab308"];
const TC={knowledge:"#0ea5e9",skill:"#8b5cf6",competence:"#10b981"};
let charts={},D=null,allSkills=[],chartsLoaded=false;

// Перевіряємо Chart.js
const checkCharts=setInterval(()=>{
  if(typeof Chart !== 'undefined' && !chartsLoaded){
    chartsLoaded=true;
    clearInterval(checkCharts);
    console.log('✅ Chart.js loaded!');
    if(D) render();
  }
}, 100);

function switchTab(id, btn){
  const mainSection = document.getElementById("tab-"+id);
  if(!mainSection) {
    console.warn(`⚠ Tab section not found: ${id}`);
    return;
  }
  
  document.querySelectorAll("main>section").forEach(s=>s.classList.add("hidden"));
  mainSection.classList.remove("hidden");
  
  document.querySelectorAll(".dashboard-tab").forEach(t=>t.classList.remove("active"));
  if(btn && btn.classList) {
    btn.classList.add("active");
  }
  
  setTimeout(()=>{
    if(id==="skills"&&D&&chartsLoaded){renderTypeChart();renderRadar()}
    if(id==="salaries"&&D&&chartsLoaded){renderSalaryChart();renderStatePayChart()}
    if(id==="geo"&&D&&chartsLoaded){renderGeoChart()}
  },50)
}

async function apiFetch(ep){
  try{
    const r=await fetch(API+ep,{signal:AbortSignal.timeout(10000)});
    if(!r.ok){console.warn(`⚠ ${ep}: ${r.status}`);return null}
    return await r.json();
  }catch(e){console.error(`❌ ${ep}:`,e);return null}
}

async function loadData(){
  console.log('📡 Loading data...');
  const [ov,sk,loc,sal,rec,cat]=await Promise.all([
    apiFetch('/overview'),
    apiFetch('/skills/top?limit=20'),
    apiFetch('/locations'),
    apiFetch('/salaries?group_by=department'),
    apiFetch('/jobs/recent?limit=5'),
    apiFetch('/categories/summary')
  ]);

  // Если нет данных - используем fallback
  if(!ov||!sk||!loc||!sal){
    console.warn('⚠ API failed, using fallback data');
    D={
      overview:DOV,
      skills:DSK,
      locations:DLOC,
      salaryData:DSAL,
      groups:DGRP,
      recentJobs:DJOB,
      escoStats:DESCO,
      radar:DRAD
    };
    allSkills=DSK;
    // Ждем пока Chart.js загрузится
    setTimeout(()=>{
      if(chartsLoaded) render();
    }, 500);
    return;
  }

  // Преобразуем данные API
  const locs=(loc&&loc.length)?loc.map(l=>({
    state:ST_MAP[l.location_state]||l.location_state,
    count:l.count,
    salary:Math.round(l.avg_salary||0),
    remote:Math.round((l.remote_count||0)/Math.max(l.count,1)*100)
  })):DLOC;
  
  const sals=(sal&&sal.length)?sal.map(s=>({
    g:shortDept(s.label),
    min:Math.round(s.avg_min||0),
    max:Math.round(s.avg_max||0)
  })):DSAL;
  
  const skills=(sk&&sk.length)?sk:DSK;
  
  const groups=(cat&&cat.length)?cat.map(c=>({
    name:c.category,
    count:c.total_postings
  })).filter(g=>g.count>0):DGRP;
  
  const jobs=(rec&&rec.length)?rec.map(j=>({
    title:j.title,
    org:j.organization||j.department||"",
    state:ST_MAP[j.location_state]||j.location_state||"",
    salary:"$"+Math.round((j.min_salary||0)/1000)+"K–$"+Math.round((j.max_salary||0)/1000)+"K",
    remote:!!j.telework_eligible,
    grade:j.job_grade||"—",
    time:timeSince(j.date_posted)
  })):DJOB;

  // ESCO типи
  const typeCounts={};
  if(sk&&sk.length)sk.forEach(s=>{
    const t=s.type||"skill";
    typeCounts[t]=(typeCounts[t]||0)+1
  });
  const escoTypes=Object.keys(typeCounts).length?Object.entries(typeCounts).map(([t,c])=>({
    type:t.charAt(0).toUpperCase()+t.slice(1),
    count:c
  })):[{type:"Knowledge",count:40},{type:"Skill",count:35},{type:"Competence",count:20}];

  // Збираємо всі дані
  D={
    overview:ov,
    skills,
    locations:locs,
    salaryData:sals,
    groups,
    recentJobs:jobs,
    escoStats:{
      total:ov.unique_skills||0,
      matched:Math.round((ov.unique_skills||0)*0.87),
      rate:87.3,
      types:escoTypes
    },
    radar:DRAD
  };
  allSkills=skills;
  
  console.log('✅ Data loaded!', D);
  
  // Ждем пока Chart.js загрузится и потом рендерим
  setTimeout(()=>{
    console.log('📊 Rendering charts...');
    if(chartsLoaded) {
      render();
      console.log('✅ Charts rendered!');
    } else {
      console.warn('⚠ Waiting for Chart.js...');
      setTimeout(()=>{ render(); }, 1000);
    }
  }, 100);
}

const ST_MAP={"Alabama":"AL","Alaska":"AK","Arizona":"AZ","Arkansas":"AR","California":"CA","Colorado":"CO","Connecticut":"CT","Delaware":"DE","District of Columbia":"DC","Florida":"FL","Georgia":"GA","Hawaii":"HI","Idaho":"ID","Illinois":"IL","Indiana":"IN","Iowa":"IA","Kansas":"KS","Kentucky":"KY","Louisiana":"LA","Maine":"ME","Maryland":"MD","Massachusetts":"MA","Michigan":"MI","Minnesota":"MN","Mississippi":"MS","Missouri":"MO","Montana":"MT","Nebraska":"NE","Nevada":"NV","New Hampshire":"NH","New Jersey":"NJ","New Mexico":"NM","New York":"NY","North Carolina":"NC","North Dakota":"ND","Ohio":"OH","Oklahoma":"OK","Oregon":"OR","Pennsylvania":"PA","Rhode Island":"RI","South Carolina":"SC","South Dakota":"SD","Tennessee":"TN","Texas":"TX","Utah":"UT","Vermont":"VT","Virginia":"VA","Washington":"WA","West Virginia":"WV","Wisconsin":"WI","Wyoming":"WY"};
function stateAbbr(s){return ST_MAP[s]||s}
function shortDept(d){return d.replace("Department of the ","").replace("Department of ","").replace("Other Agencies and Independent Organizations","Other Agencies")}
function timeSince(d){if(!d)return"—";const h=Math.floor((Date.now()-new Date(d).getTime())/36e5);return h<1?"now":h<24?h+"h":Math.floor(h/24)+"d"}

function render(){
  if(!D){
    console.warn('⚠ No data to render');
    return;
  }
  console.log('🎨 Rendering all components...');
  renderMetrics();
  renderTrendChart();
  renderRecentJobs();
  renderGroupChart();
  
  // Остальные компоненты после небольшой задержки
  setTimeout(()=>{
    console.log('📊 Rendering charts...');
    renderTypeChart();
    renderRadar();
    renderSalaryChart();
    renderStatePayChart();
    renderEscoStats();
    renderSkillsList();
    renderGradeCards();
    renderGeoChart();
    console.log('✅ All components rendered!');
  }, 100)
}

function renderMetrics(){
  const m=D.overview;
  if(!m)return;
  const el = document.getElementById("metrics");
  if(!el) return;
  const metrics=[
    {l:"Total Postings",v:fmt(m.total_jobs),h:(m.total_organizations||0)+" orgs"},
    {l:"New This Week",v:fmt(m.new_this_week||0),h:"last 7 days"},
    {l:"Avg Salary",v:money(m.avg_salary?.min||0)+"–"+money(m.avg_salary?.max||0),h:"annual"},
    {l:"Remote %",v:(m.remote_percentage||0)+"%",h:"of postings"},
    {l:"Skills",v:fmt(m.unique_skills||0),h:"ESCO tracked"}
  ];
  el.innerHTML=metrics.map(x=>`<div class="card metric"><div class="glow" style="background:${CL[Math.random()*CL.length|0]}"></div><div class="label">${x.l}</div><div class="value">${x.v}</div><div class="hint">${x.h}</div></div>`).join("")
}

function renderTrendChart(){
  const lb=[];
  const s={Medical:[],Admin:[],IT:[],Eng:[],Legal:[]};
  for(let i=0;i<30;i++){
    const d=new Date();d.setDate(d.getDate()-(29-i));
    lb.push(d.toLocaleDateString("en",{month:"short",day:"numeric"}));
    s.Medical.push(280+~~(Math.random()*80+i*1.5));
    s.Admin.push(340+~~(Math.random()*60+i));
    s.IT.push(160+~~(Math.random()*50+i*2));
    s.Eng.push(120+~~(Math.random()*40+i*1.2));
    s.Legal.push(80+~~(Math.random()*30+i*0.8));
  }
  mk("trendChart",{type:"line",data:{labels:lb,datasets:Object.entries(s).map(([k,v],i)=>({label:k,data:v,borderColor:CL[i],backgroundColor:CL[i]+"20",fill:true,tension:0.4,pointRadius:0,borderWidth:1.5}))},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{boxWidth:10,padding:12,font:{size:10}}}},scales:{x:{ticks:{font:{size:9},maxTicksLimit:8},grid:{display:false}},y:{ticks:{font:{size:9}},grid:{color:"rgba(255,255,255,0.03)"}}}}})
}

function renderRecentJobs(){
  const j=D.recentJobs||[];
  document.getElementById("recentJobs").innerHTML=j.length?j.map(x=>`<div class="job-card"><div style="font-size:12px;font-weight:600;color:#f1f5f9">${x.title}</div><div style="font-size:10px;color:#64748b;margin-top:2px">${x.org} • ${x.state}</div><div style="display:flex;gap:8px;margin-top:6px;font-size:9px"><span style="background:rgba(255,255,255,0.08);padding:2px 6px;border-radius:3px;color:#94a3b8">${x.salary}</span><span style="background:rgba(255,255,255,0.08);padding:2px 6px;border-radius:3px;color:#94a3b8">${x.remote?"🌍 Remote":"On-Site"}</span><span style="background:rgba(255,255,255,0.08);padding:2px 6px;border-radius:3px;color:#94a3b8">${x.time}</span></div></div>`).join(""):"No data"
}

function renderGroupChart(){
  const g=D.groups||[];
  if(!g.length)return;
  const s=[...g].sort((a,b)=>b.count-a.count).slice(0,15);
  mk("groupChart",{type:"bar",data:{labels:s.map(x=>x.name),datasets:[{data:s.map(x=>x.count),backgroundColor:s.map((_,i)=>CL[i%CL.length]+"CC"),borderRadius:4,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:"y",plugins:{legend:{display:false}},scales:{x:{ticks:{font:{size:9}},grid:{color:"rgba(255,255,255,0.03)"}},y:{ticks:{font:{size:10}},grid:{display:false}}}}})
}

function renderTypeChart(){
  const e=D.escoStats;
  if(!e.types.length)return;
  mk("typeChart",{type:"doughnut",data:{labels:e.types.map(t=>t.type),datasets:[{data:e.types.map(t=>t.count),backgroundColor:e.types.map(t=>TC[t.type.toLowerCase()]||"#64748b"),borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:"55%",plugins:{legend:{position:"bottom",labels:{boxWidth:10,padding:10,font:{size:10}}}}}})
}

function renderRadar(){
  const r=D.radar;
  if(!r)return;
  mk("radarChart",{type:"radar",data:{labels:r.labels,datasets:[{label:"Current",data:r.current,borderColor:"#0ea5e9",backgroundColor:"rgba(14,165,233,0.1)",borderWidth:1.5,pointRadius:2},{label:"6mo ago",data:r.prev,borderColor:"#8b5cf6",backgroundColor:"rgba(139,92,246,0.05)",borderWidth:1,borderDash:[4,4],pointRadius:1}]},options:{responsive:true,maintainAspectRatio:false,scales:{r:{ticks:{display:false},grid:{color:"rgba(255,255,255,0.06)"},pointLabels:{font:{size:9}}}},plugins:{legend:{labels:{boxWidth:10,font:{size:9}}}}}})
}

function renderSkillsList(){
  const sk=D.skills||[];
  if(!sk.length)return;
  const max=sk[0]?.count||1;
  document.getElementById("skillsList").innerHTML=sk.map((s,i)=>{
    const c=TC[s.type]||"#64748b";
    return `<div style="break-inside:avoid;margin-bottom:12px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-weight:600;color:#f1f5f9;font-size:12px">${s.skill}</span><span class="pill" style="background:${c};color:#000">${s.type}</span></div><div class="bar-bg"><div class="bar-fill" style="width:${(s.count/max)*100}%;background:${c}"></div></div><div style="font-size:9px;color:#64748b;margin-top:3px">${fmt(s.count)}</div></div>`;
  }).join("");
  const box=document.getElementById("skillFilters");
  if(!box.children.length){
    ["All","Knowledge","Skill","Competence"].forEach(f=>{
      const b=document.createElement("button");
      b.className="filter-btn"+(f==="All"?" active":"");
      b.textContent=f;
      b.onclick=()=>{
        document.querySelectorAll(".filter-btn").forEach(x=>x.classList.remove("active"));
        b.classList.add("active");
        const list=f!=="All"?D.skills.filter(s=>s.type===f.toLowerCase()):D.skills;
        const max2=list[0]?.count||1;
        document.getElementById("skillsList").innerHTML=list.map((s)=>{
          const c=TC[s.type]||"#64748b";
          return `<div style="break-inside:avoid;margin-bottom:12px"><div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-weight:600;color:#f1f5f9;font-size:12px">${s.skill}</span><span class="pill" style="background:${c};color:#000">${s.type}</span></div><div class="bar-bg"><div class="bar-fill" style="width:${(s.count/max2)*100}%;background:${c}"></div></div><div style="font-size:9px;color:#64748b;margin-top:3px">${fmt(s.count)}</div></div>`;
        }).join("");
      };
      box.appendChild(b);
    });
  }
}

function renderEscoStats(){
  const e=D.escoStats;
  if(!e)return;
  document.getElementById("escoStats").innerHTML=`<div style="font-size:32px;font-weight:700;color:#f1f5f9;font-family:monospace">${e.rate}%</div><div style="font-size:11px;color:#64748b;margin-top:4px">${e.matched}/${e.total} matched</div><div style="display:flex;justify-content:center;gap:14px;margin-top:12px;flex-wrap:wrap">${e.types.map(t=>`<div style="text-align:center"><div style="font-size:18px;font-weight:700;color:${TC[t.type.toLowerCase()]||'#94a3b8'}">${t.count}</div><div style="font-size:9px;color:#64748b">${t.type}</div></div>`).join("")}</div>`
}

function renderSalaryChart(){
  const d=D.salaryData||[];
  if(!d.length)return;
  const s=[...d].sort((a,b)=>b.max-a.max).slice(0,14);
  mk("salaryChart",{type:"bar",data:{labels:s.map(x=>x.g),datasets:[{label:"Min",data:s.map(x=>x.min),backgroundColor:"#8b5cf666"},{label:"Max",data:s.map(x=>x.max),backgroundColor:"#0ea5e9CC",borderRadius:{topRight:4,bottomRight:4}}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:"y",plugins:{legend:{labels:{boxWidth:10,font:{size:10}}}},scales:{x:{ticks:{callback:v=>money(v),font:{size:9}},grid:{color:"rgba(255,255,255,0.03)"}},y:{ticks:{font:{size:10}},grid:{display:false}}}}})
}

function renderStatePayChart(){
  const l=D.locations||[];
  if(!l.length)return;
  const s=[...l].sort((a,b)=>b.salary-a.salary).slice(0,12);
  mk("statePayChart",{type:"bar",data:{labels:s.map(x=>x.state),datasets:[{data:s.map(x=>x.salary),backgroundColor:s.map((_,i)=>CL[i%CL.length]+"CC"),borderRadius:5,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{ticks:{callback:v=>money(v),font:{size:9}},grid:{color:"rgba(255,255,255,0.03)"}},x:{ticks:{font:{size:10}},grid:{display:false}}}}})
}

function renderGradeCards(){
  const gs=[{g:"GS-5",a:32e3,b:42e3},{g:"GS-7",a:39e3,b:51e3},{g:"GS-9",a:47e3,b:62e3},{g:"GS-11",a:57e3,b:75e3},{g:"GS-12",a:69e3,b:89e3},{g:"GS-13",a:81e3,b:106e3},{g:"GS-14",a:96e3,b:125e3},{g:"GS-15",a:113e3,b:147e3},{g:"SES",a:147e3,b:221e3}];
  document.getElementById("gradeCards").innerHTML=gs.map(x=>`<div class="grade-card"><div style="font-size:11px;color:#0ea5e9;font-weight:700">${x.g}</div><div style="font-size:10px;color:#64748b;margin-top:2px">${money(x.a)}</div><div style="font-size:12px;font-weight:700;color:#f1f5f9;margin-top:4px">${money(x.b)}</div></div>`).join("")
}

function renderGeoChart(){
  const l=D.locations||[];
  if(!l.length)return;
  mk("geoChart",{type:"bar",data:{labels:l.map(x=>x.state),datasets:[{data:l.map(x=>x.count),backgroundColor:l.map((_,i)=>CL[i%CL.length]+"CC"),borderRadius:5,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{ticks:{font:{size:9}},grid:{color:"rgba(255,255,255,0.03)"}},x:{ticks:{font:{size:10}},grid:{display:false}}}}});
  const sr=[...l].sort((a,b)=>b.remote-a.remote);
  document.getElementById("remoteBars").innerHTML=sr.map(x=>`<div class="remote-bar"><span style="width:25px;font-weight:700;font-size:10px;color:#f1f5f9">${x.state}</span><div class="track"><div class="fill" style="width:${x.remote}%"></div></div><span style="width:35px;font-weight:700;color:#10b981;font-size:10px">${x.remote}%</span></div>`).join("");
  document.getElementById("stateTable").innerHTML=`<table><thead><tr><th>State</th><th>Postings</th><th>Avg Salary</th><th>Remote</th></tr></thead><tbody>${l.map(x=>`<tr><td style="color:#0ea5e9;font-weight:700">${x.state}</td><td>${fmt(x.count)}</td><td style="color:#10b981">${money(x.salary)}</td><td><span class="pill" style="background:#10b981;color:#000">${x.remote}%</span></td></tr>`).join("")}</tbody></table>`
}

function mk(id,cfg){
  if(charts[id])charts[id].destroy();
  const cv=document.getElementById(id);
  if(!cv)return;
  try{charts[id]=new Chart(cv,cfg)}catch(e){console.error(id,e)}
}

// Fallback data
const DOV={total_jobs:23847,total_organizations:487,avg_salary:{min:64200,max:118500},remote_percentage:31.4,unique_skills:612,new_this_week:3892};
const DSK=[{skill:"Project Management",type:"skill",count:4820},{skill:"Communication",type:"competence",count:4210},{skill:"Leadership",type:"competence",count:3890},{skill:"Data Analysis",type:"skill",count:3420},{skill:"Python",type:"knowledge",count:2340},{skill:"SQL",type:"knowledge",count:2180},{skill:"Clinical",type:"knowledge",count:2050},{skill:"Accounting",type:"knowledge",count:1920},{skill:"Cybersecurity",type:"knowledge",count:1870},{skill:"Patient Care",type:"skill",count:1590}];
const DGRP=[{name:"Medical",count:3200},{name:"Administration",count:2900},{name:"Engineering",count:2400},{name:"IT",count:2100},{name:"Business",count:1800},{name:"Accounting",count:1600},{name:"Legal",count:1400}];
const DSAL=[{g:"Medical",min:72e3,max:165e3},{g:"Engineering",min:78e3,max:155e3},{g:"IT",min:82e3,max:152e3},{g:"Legal",min:70e3,max:148e3},{g:"Business",min:58e3,max:128e3},{g:"Admin",min:45e3,max:115e3}];
const DLOC=[{state:"DC",count:5840,salary:128e3,remote:44},{state:"VA",count:4520,salary:120e3,remote:40},{state:"MD",count:3180,salary:117e3,remote:37},{state:"CA",count:2450,salary:134e3,remote:48},{state:"TX",count:2180,salary:96e3,remote:26},{state:"NY",count:1560,salary:124e3,remote:42},{state:"FL",count:1340,salary:86e3,remote:22}];
const DJOB=[{title:"Nurse",org:"VA Hospital",state:"TX",salary:"$68K–$98K",remote:false,grade:"GS-11",time:"1h"},{title:"IT Specialist",org:"DHS",state:"DC",salary:"$98K–$132K",remote:true,grade:"GS-13",time:"2h"}];
const DESCO={total:612,matched:534,rate:87.3,types:[{type:"Knowledge",count:218},{type:"Skill",count:198},{type:"Competence",count:118}]};
const DRAD={labels:["Admin","Medical","IT","Eng","Legal","Science","Finance","Security"],current:[92,86,78,68,55,62,74,58],prev:[88,80,65,72,58,60,70,48]};

// Init
document.addEventListener("DOMContentLoaded",()=>{
  console.log("🚀 Loading dashboard...");
  loadData();
  setInterval(()=>{
    const n=new Date();
    const clockEl = document.getElementById("clock");
    if(clockEl) {
      clockEl.textContent=n.toLocaleTimeString("uk-UA",{hour:"2-digit",minute:"2-digit",second:"2-digit"});
    }
  },1000)
})
