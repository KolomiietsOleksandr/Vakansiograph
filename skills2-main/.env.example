# Required (for Gemini provider)
GEMINI_API_KEY=your_key_here

# LLM provider: "gemini" (default) or "vllm"
# LLM_PROVIDER=gemini

# vLLM / OpenAI-compatible server settings
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=gpt-oss-120b
# VLLM_API_KEY=EMPTY

# Optional overrides (all have defaults)
# GEMINI_MODEL=gemini-2.5-flash
# ESCO_LANGUAGE=uk
# SAMPLE_SIZE=100
# FUZZY_THRESHOLD=80.0
# EMBEDDING_THRESHOLD=0.69
